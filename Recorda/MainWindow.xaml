<Window x:Class="Recorda.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Recorda" Height="780" Width="820"
        MinHeight="680" MinWidth="660"
        FontFamily="Segoe UI Variable Text"
        Icon="icon.ico"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <SolidColorBrush x:Key="CanvasBrush" Color="#0B0F13"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#12181E"/>
        <SolidColorBrush x:Key="RaisedBrush" Color="#182129"/>
        <SolidColorBrush x:Key="LineBrush" Color="#26323B"/>
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F2F5F4"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#8E9CA5"/>
        <SolidColorBrush x:Key="SignalBrush" Color="#E94D3D"/>
        <SolidColorBrush x:Key="SignalDarkBrush" Color="#A92F26"/>
        <SolidColorBrush x:Key="MeterBrush" Color="#54D6A0"/>
        <SolidColorBrush x:Key="AmberBrush" Color="#F2B84B"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="{StaticResource RaisedBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#22303A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource MeterBrush}"/>
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RecordButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonStyle}">
            <Setter Property="Width" Value="112"/>
            <Setter Property="Height" Value="112"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="{StaticResource SignalBrush}"/>
            <Setter Property="BorderBrush" Value="#FF7467"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Halo" Fill="#26E94D3D" Margin="-9" Opacity="0"/>
                            <Ellipse x:Name="Disc"
                                     Fill="{TemplateBinding Background}"
                                     Stroke="{TemplateBinding BorderBrush}"
                                     StrokeThickness="{TemplateBinding BorderThickness}"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Halo" Property="Opacity" Value="1"/>
                                <Setter TargetName="Disc" Property="Fill" Value="#F25A49"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Disc" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Halo" Property="Opacity" Value="1"/>
                                <Setter TargetName="Disc" Property="Stroke" Value="White"/>
                                <Setter TargetName="Disc" Property="StrokeThickness" Value="3"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Disc" Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputStyle" TargetType="Control">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="#0E1419"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="ComboBoxInputStyle" TargetType="ComboBox" BasedOn="{StaticResource InputStyle}">
            <Setter Property="Foreground" Value="#111820"/>
            <Setter Property="Background" Value="#F3F5F6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#111820"/>
                        <Setter Property="Background" Value="#F3F5F6"/>
                        <Setter Property="Padding" Value="8,6"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MeterStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="1"/>
            <Setter Property="Background" Value="#263039"/>
            <Setter Property="Foreground" Value="{StaticResource MeterBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid ClipToBounds="True">
                            <Border Background="{TemplateBinding Background}" CornerRadius="3"/>
                            <Border x:Name="PART_Indicator"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="3"
                                    HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#202A32"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource CanvasBrush}" Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="9" Height="9" CornerRadius="5" Background="{StaticResource SignalBrush}" Margin="0,0,10,0"/>
                    <TextBlock Text="RECORDA" FontFamily="Bahnschrift SemiBold" FontSize="18"
                               Foreground="{StaticResource PrimaryTextBrush}"/>
                    <TextBlock Text="  /  dual-source recorder" FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" MinWidth="370"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="2*" MinWidth="230"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="22,18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="190"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="112"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <Border x:Name="StatePill" HorizontalAlignment="Left" Background="#183029" CornerRadius="12" Padding="10,4">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse x:Name="StateDot" Width="7" Height="7" Fill="{StaticResource MeterBrush}" Margin="0,0,7,0"/>
                                                <TextBlock x:Name="StateText" Text="READY" Foreground="{StaticResource MeterBrush}"
                                                           FontFamily="Bahnschrift SemiBold" FontSize="10"/>
                                            </StackPanel>
                                        </Border>

                                        <TextBlock x:Name="TimerText" Text="00:00:00" HorizontalAlignment="Left"
                                                   FontFamily="Bahnschrift Light" FontSize="42"
                                                   Foreground="{StaticResource PrimaryTextBrush}" Margin="0,8,0,10"
                                                   automation:AutomationProperties.Name="Elapsed recording time"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="58"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="34"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="8"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Style="{StaticResource LabelStyle}" Text="MIC"/>
                                            <ProgressBar x:Name="MicLevelBar" Grid.Row="0" Grid.Column="1" Style="{StaticResource MeterStyle}" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="MicLevelText" Grid.Row="0" Grid.Column="2" Text="—" Style="{StaticResource LabelStyle}" HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Row="2" Style="{StaticResource LabelStyle}" Text="SYSTEM"/>
                                            <ProgressBar x:Name="SystemLevelBar" Grid.Row="2" Grid.Column="1" Style="{StaticResource MeterStyle}" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="SystemLevelText" Grid.Row="2" Grid.Column="2" Text="—" Style="{StaticResource LabelStyle}" HorizontalAlignment="Right"/>
                                        </Grid>

                                        <TextBlock x:Name="StatusText" Text="Choose Record when you’re ready."
                                                   Foreground="{StaticResource SecondaryTextBrush}" FontSize="11"
                                                   TextWrapping="Wrap" Margin="0,12,0,0"
                                                   automation:AutomationProperties.LiveSetting="Polite"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <Button x:Name="RecordBtn" Style="{StaticResource RecordButtonStyle}"
                                                Click="RecordBtn_Click" automation:AutomationProperties.Name="Start recording"
                                                automation:AutomationProperties.HelpText="Start or stop recording. Keyboard shortcut Control R.">
                                            <StackPanel>
                                                <Rectangle x:Name="RecordGlyph" Width="21" Height="21" RadiusX="11" RadiusY="11" Fill="White" HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="RecordBtnText" Text="RECORD" Foreground="White" FontFamily="Bahnschrift SemiBold"
                                                           FontSize="11" Margin="0,7,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="MuteMicBtn" Style="{StaticResource ButtonStyle}"
                                                Height="40" Margin="0,9,0,0" IsEnabled="False" Padding="8,6"
                                                Content="MUTE MIC" Click="MuteMicBtn_Click"
                                                automation:AutomationProperties.Name="Mute microphone" ToolTip="Mute microphone (Ctrl+M)"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel x:Name="FinalizingPanel" Grid.Row="1" Visibility="Collapsed" Margin="0,14,0,0">
                                    <ProgressBar x:Name="FinalizingProgress" Style="{StaticResource MeterStyle}" Height="4"/>
                                    <TextBlock x:Name="FinalizingText" Text="Preparing audio…" Style="{StaticResource LabelStyle}"
                                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel x:Name="SetupSection" Grid.Row="2">
                            <TextBlock Text="RECORDING SETUP" FontFamily="Bahnschrift SemiBold" FontSize="11"
                                       Foreground="{StaticResource PrimaryTextBrush}" Margin="4,0,0,6"/>
                            <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,6,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="10"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="10"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="MICROPHONE" Margin="0,0,0,6"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource LabelStyle}" Text="SYSTEM AUDIO" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="MicCombo" Grid.Row="1" Grid.Column="0" Style="{StaticResource ComboBoxInputStyle}" Height="34"
                                              Padding="8,0" DisplayMemberPath="FriendlyName" SelectionChanged="DeviceSelectionChanged"/>
                                    <ComboBox x:Name="OutputCombo" Grid.Row="1" Grid.Column="2" Style="{StaticResource ComboBoxInputStyle}" Height="34"
                                              Padding="8,0" DisplayMemberPath="FriendlyName" SelectionChanged="DeviceSelectionChanged"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="MIC LEVEL" Margin="0,0,0,6"/>
                                    <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource LabelStyle}" Text="SYSTEM LEVEL" Margin="0,0,0,6"/>
                                    <Slider x:Name="MicGainSlider" Grid.Row="4" Grid.Column="0" Minimum="0" Maximum="1" Value="0.72"
                                            ValueChanged="GainSlider_ValueChanged" ToolTip="Microphone gain used in the final mix"/>
                                    <Slider x:Name="SystemGainSlider" Grid.Row="4" Grid.Column="2" Minimum="0" Maximum="1" Value="0.72"
                                            ValueChanged="GainSlider_ValueChanged" ToolTip="System-audio gain used in the final mix"/>

                                    <TextBlock Grid.Row="6" Grid.ColumnSpan="3" Style="{StaticResource LabelStyle}" Text="SAVE RECORDINGS TO" Margin="0,0,0,6"/>
                                    <Grid Grid.Row="7" Grid.ColumnSpan="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="OutputFolderBox" Grid.Column="0" Style="{StaticResource InputStyle}" Height="34" IsReadOnly="True" Padding="8,0" VerticalContentAlignment="Center"/>
                                        <Button x:Name="BrowseBtn" Grid.Column="2" Style="{StaticResource ButtonStyle}" Padding="11,7" Content="BROWSE" Click="BrowseBtn_Click"/>
                                        <Button x:Name="OpenFolderBtn" Grid.Column="4" Style="{StaticResource ButtonStyle}" Padding="11,7" Content="OPEN" Click="OpenFolderBtn_Click"/>
                                        <Button x:Name="RefreshBtn" Grid.Column="6" Style="{StaticResource ButtonStyle}" Padding="11,7" Content="↻" Click="RefreshBtn_Click" ToolTip="Refresh audio devices"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <Grid Grid.Row="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="DIAGNOSTICS" FontFamily="Bahnschrift SemiBold" FontSize="10"
                                       Foreground="{StaticResource SecondaryTextBrush}" Margin="4,0,0,0"/>
                            <ListBox x:Name="LogList" Grid.Row="2" Padding="8"
                                     Background="#0E1419" BorderBrush="{StaticResource LineBrush}" Foreground="{StaticResource SecondaryTextBrush}"
                                     FontFamily="Cascadia Mono" FontSize="10"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     HorizontalContentAlignment="Stretch">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="0,2"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                </Grid>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="RECENT TAKES" FontFamily="Bahnschrift SemiBold" FontSize="12"
                                           Foreground="{StaticResource PrimaryTextBrush}"/>
                                <TextBlock Text="Your latest recordings" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource ButtonStyle}" Padding="9,6" Content="↻" Click="ReloadRecordings_Click" ToolTip="Reload recordings"/>
                        </Grid>

                        <Grid Grid.Row="2">
                            <TextBlock x:Name="EmptyRecordingsText" Text="No takes yet.&#x0a;Your recordings will appear here."
                                       TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <ListBox x:Name="RecordingsList" Background="Transparent" BorderThickness="0" Padding="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,0,9"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="11" Padding="12">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="10"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Row="1" Text="{Binding Details}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" Margin="0,4,0,0"/>
                                                <WrapPanel Grid.Row="3" Orientation="Horizontal">
                                                    <Button Style="{StaticResource ButtonStyle}" Padding="10,6" Content="PLAY" Tag="{Binding}" Click="PlayRecording_Click"/>
                                                    <Button Style="{StaticResource ButtonStyle}" Padding="10,6" Margin="6,0,0,0" Content="REVEAL" Tag="{Binding}" Click="RevealRecording_Click"/>
                                                    <Button Style="{StaticResource ButtonStyle}" Padding="10,6" Margin="6,0,0,0" Content="COPY" Tag="{Binding}" Click="CopyRecordingPath_Click"/>
                                                    <Button Style="{StaticResource ButtonStyle}" Padding="10,6" Margin="6,0,0,0" Content="DELETE" Tag="{Binding}" Click="DeleteRecording_Click"/>
                                                </WrapPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
